{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas.vibesketch.ai/schemas/workspace.v1.json",
  "title": "CanvasWorkspace",
  "description": "Serialized schema for CANVAS workspace state including base map and semantic layers",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspaceId",
    "title",
    "baseMap",
    "layers",
    "activeLayerId",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "baseMap": {
      "type": "object",
      "required": ["styleUrl", "center", "zoom"],
      "properties": {
        "styleUrl": {
          "type": "string"
        },
        "center": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180.0, "maximum": 180.0 },
            { "type": "number", "minimum": -90.0, "maximum": 90.0 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 24.0
        },
        "bearing": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 360.0,
          "default": 0.0
        },
        "pitch": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 85.0,
          "default": 0.0
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "semanticType",
          "order",
          "visible",
          "opacity",
          "locked",
          "entities",
          "metadata",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "semanticType": {
            "type": "string",
            "enum": [
              "baseline",
              "tactical",
              "infrastructure",
              "environmental",
              "annotation",
              "custom"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "locked": {
            "type": "boolean"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "layerId", "semanticClass", "geometry", "properties"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "layerId": { "type": "string", "format": "uuid" },
                "semanticClass": { "type": "string", "minLength": 1 },
                "geometry": { "type": "object" },
                "properties": { "type": "object" }
              }
            }
          },
          "metadata": {
            "type": "object"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "activeLayerId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
