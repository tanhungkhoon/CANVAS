{
  "name": "canvas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CANVAS - Context-Aware Naturally Vibe AI Sketcher",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=@canvas/core",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "npm run dev --workspace=@canvas/web"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
